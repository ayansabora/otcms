# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Database (MySQL 8.0+) ────────────────────────────────────────────────
# Use 127.0.0.1 instead of localhost on Windows to avoid IPv6 resolution issues.
# The otcms user must have CREATE DATABASE privilege for Prisma shadow DB.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://otcms:yourpassword@127.0.0.1:3306/otcms

# ── Auth secrets ─────────────────────────────────────────────────────────
# Generate strong random secrets: openssl rand -base64 48
# ACCESS and REFRESH secrets must be different from each other.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── File storage ─────────────────────────────────────────────────────────
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage/documents
FILE_MAX_SIZE_MB=15

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Rate limiting ─────────────────────────────────────────────────────────
# WINDOW_MS = 900000 (15 minutes). Increase AUTH_RATE_LIMIT_MAX during
# development to avoid lockouts from repeated test logins.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=100
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# ── Seed data (development only) ─────────────────────────────────────────
# Admin account created by npm run seed. NEVER use these passwords in production.
# Must meet policy: min 12 chars, at least one letter and one number.
SEED_ADMIN_PASSWORD=ChangeMe12345!
SEED_OFFICER_PASSWORD=Officer12345!
SEED_MANAGER_PASSWORD=Manager12345!

# ── Quick-start steps ─────────────────────────────────────────────────────
# 1. Copy this file to .env and fill in your real values.
# 2. Create MySQL user: CREATE USER 'otcms'@'localhost' IDENTIFIED WITH mysql_native_password BY 'yourpassword';
# 3. Create database:   CREATE DATABASE otcms CHARACTER SET utf8mb4;
# 4. Grant access:      GRANT ALL PRIVILEGES ON otcms.* TO 'otcms'@'localhost'; FLUSH PRIVILEGES;
# 5. Push schema:       npx prisma db push
# 6. Seed data:         npm run seed
# 7. Start backend:     npm run dev   (port 4000)
# 8. Start frontend:    npm run dev   (in repo root, port 5173)
