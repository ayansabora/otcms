# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Database (MySQL 9.7 LTS) ────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://otcms:yourpassword@localhost:3306/otcms

# ── Auth secrets ─────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_ACCESS_TTL=25m
JWT_REFRESH_TTL=7d

# ── File storage ─────────────────────────────────────────────────────────
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage/documents
FILE_MAX_SIZE_MB=15

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Rate limiting / brute-force protection ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# ── Seed data (development only — never set/use in production) ─────────
SEED_ADMIN_PASSWORD=ChangeMe12345!
