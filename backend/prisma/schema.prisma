// OTCMS - Prisma schema
// Database: MySQL 9.7 LTS (see /docs/architecture.md for rationale)
//
// NOTE ON OPEN BUSINESS-RULE DECISIONS (see blueprint §11/§27):
// The elder-panel / consensus-approval model (`CaseAssignment` + `DecisionApproval`)
// and the verification/witness-count fields below are DEFAULTS pending your
// confirmation. They are intentionally modeled as configurable (quorum thresholds,
// minimum witness counts) rather than hard-coded single-approver rules, so we don't
// bake in an incorrect legal/cultural assumption. Adjust once confirmed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth / RBAC
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  phone        String?  @db.VarChar(32)
  status       UserStatus @default(ACTIVE)
  failedLoginAttempts Int  @default(0) @map("failed_login_attempts")
  lockedUntil  DateTime? @map("locked_until")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  archivedAt   DateTime? @map("archived_at")

  roles              UserRole[]
  communityMember    CommunityMember?
  caseAssignments    CaseAssignment[]
  decisionApprovals  DecisionApproval[]
  uploadedDocuments  Document[]         @relation("DocumentUploadedBy")
  notifications      Notification[]
  auditLogs          AuditLog[]
  hearingParticipant HearingParticipant[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(64) // e.g. ADMIN, COURT_MANAGER, ELDER, RECORD_OFFICER
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(128) // e.g. "case:create", "decision:approve"
  description String?  @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────
// Community Members
// ─────────────────────────────────────────────────────────────────────────

model CommunityMember {
  id                 String                     @id @default(uuid())
  userId             String?                    @unique @map("user_id") // nullable: a member may not have login access
  fullName           String                     @map("full_name") @db.VarChar(255)
  gender             String?                    @db.VarChar(32)
  dateOfBirth        DateTime?                  @map("date_of_birth")
  phone              String?                    @db.VarChar(32)
  address            String?                    @db.VarChar(255)
  kebele             String?                    @db.VarChar(128)
  identificationRef  String?                    @map("identification_ref") @db.VarChar(128)
  verificationStatus MemberVerificationStatus   @default(PENDING) @map("verification_status")
  verifiedByUserId   String?                    @map("verified_by_user_id")
  verifiedAt         DateTime?                  @map("verified_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  archivedAt         DateTime?                  @map("archived_at")

  user           User?          @relation(fields: [userId], references: [id])
  caseParties    CaseParty[]
  caseWitnesses  CaseWitness[]

  @@index([verificationStatus])
  @@map("community_members")
}

enum MemberVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────
// Cases
// ─────────────────────────────────────────────────────────────────────────

model Case {
  id           String     @id @default(uuid())
  caseNumber   String     @unique @map("case_number") @db.VarChar(64) // default format OTCMS-{year}-{seq}; see blueprint §26
  caseType     CaseType   @map("case_type")
  status       CaseStatus @default(SUBMITTED)
  priority     CasePriority @default(NORMAL)
  description  String     @db.Text
  location     String?    @db.VarChar(255)
  submittedByUserId String? @map("submitted_by_user_id")
  // Configurable minimum witnesses required before this case may leave UNDER_REVIEW
  // (see blueprint §11 rules 2-3). Default is a placeholder pending confirmation.
  minWitnessesRequired Int @default(2) @map("min_witnesses_required")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  archivedAt   DateTime?  @map("archived_at")

  parties     CaseParty[]
  witnesses   CaseWitness[]
  assignments CaseAssignment[]
  hearings    Hearing[]
  decisions   Decision[]
  documents   Document[]
  history     CaseHistory[]

  @@index([status])
  @@index([caseType])
  @@index([createdAt])
  @@fulltext([description])
  @@map("cases")
}

enum CaseType {
  MARRIAGE
  DIVORCE
  LAND_DISPUTE
  PROPERTY_DISPUTE
  DEBT
  ASSAULT
  DEFAMATION
  OTHER
}

enum CaseStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  ASSIGNED
  HEARING_SCHEDULED
  HEARING_IN_PROGRESS
  DECISION_PENDING
  DECIDED
  CLOSED
  REJECTED
  WITHDRAWN
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model CaseParty {
  id                String   @id @default(uuid())
  caseId            String   @map("case_id")
  communityMemberId String   @map("community_member_id")
  roleInCase        CasePartyRole @map("role_in_case")
  createdAt         DateTime @default(now()) @map("created_at")

  case            Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  communityMember CommunityMember @relation(fields: [communityMemberId], references: [id])

  @@unique([caseId, communityMemberId, roleInCase])
  @@map("case_parties")
}

enum CasePartyRole {
  COMPLAINANT
  RESPONDENT
}

model Witness {
  id                String   @id @default(uuid())
  fullName          String   @map("full_name") @db.VarChar(255)
  phone             String?  @db.VarChar(32)
  communityMemberId String?  @map("community_member_id") // optional link if witness is also a registered member
  createdAt         DateTime @default(now()) @map("created_at")

  caseWitnesses CaseWitness[]

  @@map("witnesses")
}

model CaseWitness {
  id                String   @id @default(uuid())
  caseId            String   @map("case_id")
  witnessId         String   @map("witness_id")
  testimonySummary  String?  @map("testimony_summary") @db.Text
  testifiedAt       DateTime? @map("testified_at")
  communityMemberId String?  @map("community_member_id")

  case    Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  witness Witness @relation(fields: [witnessId], references: [id])
  communityMember CommunityMember? @relation(fields: [communityMemberId], references: [id])

  @@unique([caseId, witnessId])
  @@map("case_witnesses")
}

// Elder panel assignment (see blueprint §11 consensus model — default pending confirmation)
model CaseAssignment {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  userId     String   @map("user_id") // an elder / court manager / record officer
  roleInPanel PanelRole @default(MEMBER) @map("role_in_panel")
  assignedAt DateTime @default(now()) @map("assigned_at")
  removedAt  DateTime? @map("removed_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([caseId, userId])
  @@map("case_assignments")
}

enum PanelRole {
  LEAD
  MEMBER
}

model CaseHistory {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  fromStatus CaseStatus? @map("from_status")
  toStatus   CaseStatus  @map("to_status")
  actorUserId String?  @map("actor_user_id")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_history")
}

// ─────────────────────────────────────────────────────────────────────────
// Hearings
// ─────────────────────────────────────────────────────────────────────────

model Hearing {
  id            String        @id @default(uuid())
  caseId        String        @map("case_id")
  scheduledDate DateTime      @map("scheduled_date") @db.Date
  startTime     DateTime      @map("start_time")
  endTime       DateTime      @map("end_time")
  location      String        @db.VarChar(255)
  purpose       String?       @db.VarChar(255)
  notes         String?       @db.Text
  status        HearingStatus @default(SCHEDULED)
  outcomeRef    String?       @map("outcome_ref") @db.VarChar(255)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  case         Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  participants HearingParticipant[]

  @@index([scheduledDate, location])
  @@map("hearings")
}

enum HearingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

model HearingParticipant {
  id                String   @id @default(uuid())
  hearingId         String   @map("hearing_id")
  userId            String?  @map("user_id") // elder / officer
  communityMemberId String?  @map("community_member_id") // party
  witnessId         String?  @map("witness_id")
  role              String   @db.VarChar(64) // e.g. ELDER, COMPLAINANT, RESPONDENT, WITNESS
  attended          Boolean? 

  hearing Hearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@map("hearing_participants")
}

// ─────────────────────────────────────────────────────────────────────────
// Decisions
// ─────────────────────────────────────────────────────────────────────────

model Decision {
  id             String          @id @default(uuid())
  caseId         String          @map("case_id")
  decisionDate   DateTime?       @map("decision_date")
  outcome        String          @db.VarChar(255)
  description    String          @db.Text
  remarks        String?         @db.Text
  approvalStatus DecisionApprovalStatus @default(PENDING) @map("approval_status")
  // Configurable consensus threshold (see blueprint §11) — default pending confirmation.
  requiredApprovals Int @default(2) @map("required_approvals")
  finalizedAt    DateTime?       @map("finalized_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  case      Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvals DecisionApproval[]
  documents Document[]

  @@map("decisions")
}

enum DecisionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model DecisionApproval {
  id         String   @id @default(uuid())
  decisionId String   @map("decision_id")
  userId     String   @map("user_id") // panel elder approving
  approved   Boolean
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([decisionId, userId])
  @@map("decision_approvals")
}

// ─────────────────────────────────────────────────────────────────────────
// Documents (metadata only — see blueprint §17 for storage architecture)
// ─────────────────────────────────────────────────────────────────────────

model Document {
  id           String   @id @default(uuid())
  caseId       String?  @map("case_id")
  decisionId   String?  @map("decision_id")
  filename     String   @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(128)
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @map("storage_key") @db.VarChar(512) // never a public URL
  category     String?  @db.VarChar(64)
  uploadedByUserId String @map("uploaded_by_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  archivedAt   DateTime? @map("archived_at")

  case       Case?     @relation(fields: [caseId], references: [id])
  decision   Decision? @relation(fields: [decisionId], references: [id])
  uploadedBy User      @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([caseId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @db.VarChar(64)
  title     String   @db.VarChar(255)
  body      String?  @db.Text
  payload   Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit Log (append-only)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorUserId String? @map("actor_user_id")
  action     String   @db.VarChar(128) // e.g. "case.status_changed"
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
